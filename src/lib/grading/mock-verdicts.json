 "pass": [
  {
   "items": [
    {
     "id": "q1a",
     "verdict": "met",
     "quote": "Honing with a steel just pushes a rolled edge back into line"
    },
    {
     "id": "q1b",
     "verdict": "met",
     "quote": "it takes almost no metal off"
    },
    {
     "id": "q1c",
     "verdict": "met",
     "quote": "the edge is worn, so honing for longer won't fix it. She needs to sharpen it on a stone"
    },
    {
     "id": "q2a",
     "verdict": "met",
     "quote": "Soak the stone in water until the bubbles stop, about 10 minutes."
    },
    {
     "id": "q2b",
     "verdict": "met",
     "quote": "Put a damp towel under it so it can't slide."
    },
    {
     "id": "q2c",
     "verdict": "met",
     "quote": "For a Western knife hold it at 20 degrees on each side."
    },
    {
     "id": "q2d",
     "verdict": "not_met",
     "quote": ""
    },
    {
     "id": "q3a",
     "verdict": "met",
     "quote": "Feel for a burr on the other side of the edge"
    },
    {
     "id": "q3b",
     "verdict": "met",
     "quote": "Flip when you can feel it all the way from heel to tip."
    },
    {
     "id": "q3c",
     "verdict": "met",
     "quote": "take the burr off with a few light strokes on each side, then strop on newspaper"
    },
    {
     "id": "q4a",
     "verdict": "met",
     "quote": "use a wood or plastic board instead"
    },
    {
     "id": "q4b",
     "verdict": "met",
     "quote": "Keep it out of the dishwasher and wash it by hand."
    },
    {
     "id": "q4c",
     "verdict": "met",
     "quote": "hone it about once a week"
    },
    {
